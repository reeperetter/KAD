<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Потрібно для пошуку і завантаження з YouTube -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Потрібно для завантаження треків у публічну папку "Завантаження"
         на старіших версіях Android (на 10+ здебільшого не обов'язково
         завдяки MediaStore API, але лишаємо для сумісності зі старими
         пристроями). -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!-- Потрібно на Android 11+, щоб застосунок мав право відкривати
         посилання (для кнопки "Відкрити на YouTube") - без цього система
         може приховати браузер від запиту через обмеження видимості
         пакетів. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="Music Downloader"
        android:theme="@style/Theme.MusicDownloader"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MusicDownloader.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
